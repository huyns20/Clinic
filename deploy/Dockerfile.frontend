# ========================================================
# Dockerfile Frontend React 18 + Vite 6 + Tailwind CSS
# Tối ưu siêu tốc với BuildKit Cache Mount (NPM Cache)
# ========================================================
# syntax=docker/dockerfile:1

# Stage 1: Build static assets
FROM node:20-alpine AS builder
WORKDIR /app

# Cache npm dependencies giữa các lần build
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm install

# Copy toàn bộ mã nguồn frontend và build
COPY . .
RUN npm run build

# Stage 2: Serve static qua Nginx Alpine siêu nhanh & bảo mật
FROM nginx:alpine

# Copy cấu hình reverse proxy nằm ngay trong frontend
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts từ builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
